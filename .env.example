# Configuración de la aplicación
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion

# Configuración del servidor
HOST=0.0.0.0
PORT=5000
DEBUG=True

# IA Generativa - IBM Watson/Granite (opcional)
IBM_API_KEY=tu-api-key-aqui
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# IA Generativa - OpenAI (alternativa)
OPENAI_API_KEY=tu-openai-key-aqui
OPENAI_MODEL=gpt-3.5-turbo

# Configuración del modelo
USE_GENERATIVE_AI=False
CONFIDENCE_THRESHOLD=0.7
MAX_RESPONSE_TOKENS=150

# Logging
LOG_LEVEL=INFO

# Base de datos (si se necesita)
# DATABASE_URL=sqlite:///chatbot.db
